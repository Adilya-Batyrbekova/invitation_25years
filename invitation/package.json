{
  "name": "birthday-invitation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "node scripts/task.mjs format",
    "format:check": "node scripts/task.mjs format:check",
    "test": "vitest run",
    "test:browser": "node scripts/task.mjs browser",
    "check": "node scripts/task.mjs check"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/golos-text": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "gsap": "^3.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
